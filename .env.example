# ==============================================================================
# PS 26027 - Indian Railways AI Block Planning Platform
# Environment Variables Reference (.env.example)
# Copy this file to .env and fill in all required values
# ==============================================================================

# ── Database Configuration ──────────────────────────────────────────────────
DATABASE_URL=postgresql://railway:CHANGE_ME@localhost:5433/railway_ai
DOCKER_DATABASE_URL=postgresql://railway:CHANGE_ME@postgres:5432/railway_ai
POSTGRES_USER=railway
POSTGRES_PASSWORD=CHANGE_ME          # REQUIRED - No default in production
POSTGRES_DB=railway_ai
POSTGRES_PORT=5433

# ── Redis Configuration ──────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6380/0
DOCKER_REDIS_URL=redis://redis:6379/0
REDIS_PORT=6380

# ── Application Configuration ────────────────────────────────────────────────
APP_ENV=production                   # 'development' | 'production'
API_PORT=8000
FRONTEND_PORT=5173

# REQUIRED - Generate with: python -c "import secrets; print(secrets.token_hex(64))"
SECRET_KEY=CHANGE_ME_GENERATE_STRONG_KEY_AT_LEAST_64_CHARS

ACCESS_TOKEN_EXPIRE_MINUTES=15       # Short-lived access tokens (15 min)
REFRESH_TOKEN_EXPIRE_DAYS=7          # Refresh tokens (7 days, stored in Redis)

# ── CORS ─────────────────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:5173,http://localhost:80

# ── LLM / Gemini API (Required for operational explainability briefs) ─────────
GEMINI_API_KEY=                      # Optional - fills in AI operational summaries

# ── CRIS COA & RTIS Integrations ───────────────────────────────────────────────
CRIS_COA_API_URL=https://coa.cris.org.in/api/v2
CRIS_COA_API_KEY=                    # Provisioned by CRIS New Delhi
RTIS_FEED_URL=https://rtis.cris.org.in/stream/v1
RTIS_FEED_KEY=                       # Real-Time Train Information System GPS key
KAVACH_TELEMETRY_TOKEN=              # Kavach TCAS L2 telemetry packet validation token

# ── Monitoring (Production only) ─────────────────────────────────────────────
GRAFANA_PASSWORD=CHANGE_ME           # Grafana admin password

# ── Rate Limits ──────────────────────────────────────────────────────────────
RATE_LIMIT_AUTH=10                   # /auth/login requests per minute
RATE_LIMIT_OPTIMIZER=15              # /optimize/run requests per minute
RATE_LIMIT_QUERY=120                 # /blocks /corridor requests per minute
